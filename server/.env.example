# FootIQ API server environment — copy to server/.env for local dev.
# EVERYTHING here is optional: with no values set the API boots in demo mode
# (bundled dataset, mock AI, in-memory cache, no accounts).
# NEVER commit a real .env. NEVER put any of these in the frontend.

NODE_ENV=development
PORT=8787
LOG_LEVEL=info

# Comma-separated origins allowed by CORS (the frontend's origins)
CORS_ORIGINS=http://localhost:5173

# --- Supabase (server-side; the service role key BYPASSES RLS — server only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Legacy-project JWT secret for HS256 verification. Leave empty on new
# projects (asymmetric keys are verified via the project's JWKS endpoint).
SUPABASE_JWT_SECRET=

# --- AI (leave empty to use the built-in mock provider)
# provider: claude | openai | gemini | ollama | mock
AI_PROVIDER=mock
AI_MODEL=claude-opus-4-8
AI_MAX_TOKENS=2048
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=

# --- Cache (Upstash Redis REST, free tier; empty = in-memory cache)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Football data provider (empty = demo catalog)
# provider: football-data | api-football | demo
DATA_PROVIDER=demo
# football-data.org (free: 10 req/min) — attribution required on the site
FOOTBALL_DATA_API_KEY=
FOOTBALL_DATA_COMPETITION=PL
# API-Football / api-sports.io (free: 100 req/day)
API_FOOTBALL_KEY=
API_FOOTBALL_LEAGUE=39

# --- Background sync (Node runtime; Workers use the wrangler.toml cron)
SYNC_ENABLED=
SYNC_INTERVAL_MINUTES=30

# --- Rate limit overrides (requests/minute; empty = built-in defaults)
RATE_LIMIT_API=
RATE_LIMIT_WRITES=
RATE_LIMIT_AUTH=
RATE_LIMIT_AI=
RATE_LIMIT_FORMS=

# --- Security
# Salt for hashing IPs before they touch logs/audit rows. Set a long random
# value in production.
IP_HASH_SALT=
# Set true only in tests
RATE_LIMIT_DISABLED=

# --- Observability (hook points; wiring an adapter is a later step)
SENTRY_DSN=

# --- Feature flag overrides (ops kill-switches; beat the DB and defaults)
# FLAG_AI_SCOUT=false
# FLAG_PREMIUM=true
