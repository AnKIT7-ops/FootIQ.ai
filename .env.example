# FootIQ environment — copy to .env.local and fill in what you have.
# Everything is optional: missing values simply disable the feature.

# Canonical site origin used for OG tags, canonical URLs (defaults to https://footiq.ai)
VITE_SITE_URL=

# Google Analytics 4 measurement id, e.g. G-XXXXXXXXXX (empty = analytics disabled)
VITE_GA_ID=

# Microsoft Clarity project id (empty = Clarity disabled)
VITE_CLARITY_ID=

# --- Backend integration (empty = pure demo mode, app works fully offline) ---

# FootIQ API origin, e.g. http://localhost:8787 (local) or your Workers/Render URL.
# Empty = frontend never calls the backend and serves bundled demo data.
VITE_API_URL=

# Supabase project (PUBLIC anon key only — safe to expose, enforced by RLS).
# Both empty = auth disabled, everyone browses as a guest.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
